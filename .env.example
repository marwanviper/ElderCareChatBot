# Application Settings
APP_NAME="ElderCare Chatbot API"
APP_VERSION="1.0.0"
DEBUG=True

# Database Connection (PostgreSQL or SQLite for local development)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/eldercare_db"

# Security & JWT Secrets (MUST be changed in production!)
SECRET_KEY="replace-this-with-a-secure-random-secret-key-at-least-32-characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"
