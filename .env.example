# Application Settings
APP_NAME="ElderCare Chatbot API"
APP_VERSION="1.0.0"
DEBUG=True

# Database Connection (PostgreSQL or SQLite for local development)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/eldercare_db"

# Security & JWT Secrets (MUST be changed in production!)
SECRET_KEY="replace-this-with-a-secure-random-secret-key-at-least-32-characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# AI & LLM Provider Configuration
DEFAULT_LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_DEFAULT_MODEL="gemini-2.0-flash"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_DEFAULT_MODEL="gpt-3.5-turbo"
CHAT_MAX_HISTORY_MESSAGES=20
CHAT_DEFAULT_TEMPERATURE=0.3
CHAT_DEFAULT_MAX_TOKENS=1024

# Streamlit Frontend Settings
FASTAPI_BASE_URL="http://localhost:8000"
